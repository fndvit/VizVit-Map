{
	"name": "@vit-foundation/map",
	"version": "0.1.0",
	"description": "A config-driven globe and map component, with a provider seam so the same features run on ArcGIS, MapLibre or a test double",
	"license": "Apache-2.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fndvit/VizVit-Map.git"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"_comment:prepublishOnly": "Publishing is MANUAL. This is the only gate \u2014 it runs before prepack, so a package that fails lint, type-check or tests cannot reach the registry.",
		"prepublishOnly": "npm run lint && npm run check && npm run test"
	},
	"files": [
		"dist",
		"CHANGELOG.md",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/globe/index.js",
	"types": "./dist/globe/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/globe/index.d.ts",
			"svelte": "./dist/globe/index.js",
			"default": "./dist/globe/index.js"
		},
		"./Globe.svelte": {
			"types": "./dist/globe/Globe.svelte.d.ts",
			"svelte": "./dist/globe/Globe.svelte",
			"default": "./dist/globe/Globe.svelte"
		},
		"./MapCanvas.svelte": {
			"types": "./dist/globe/MapCanvas.svelte.d.ts",
			"svelte": "./dist/globe/MapCanvas.svelte",
			"default": "./dist/globe/MapCanvas.svelte"
		},
		"./config": {
			"types": "./dist/globe/config.d.ts",
			"svelte": "./dist/globe/config.js",
			"default": "./dist/globe/config.js"
		},
		"./capability": {
			"types": "./dist/globe/capability.d.ts",
			"svelte": "./dist/globe/capability.js",
			"default": "./dist/globe/capability.js"
		},
		"./registry": {
			"types": "./dist/globe/registry.d.ts",
			"svelte": "./dist/globe/registry.js",
			"default": "./dist/globe/registry.js"
		},
		"./hover": {
			"types": "./dist/globe/hover/hoverTypes.d.ts",
			"svelte": "./dist/globe/hover/hoverTypes.js",
			"default": "./dist/globe/hover/hoverTypes.js"
		},
		"./dot-style": {
			"types": "./dist/globe/hover/dotStylePrimitives.d.ts",
			"svelte": "./dist/globe/hover/dotStylePrimitives.js",
			"default": "./dist/globe/hover/dotStylePrimitives.js"
		},
		"./engine": {
			"types": "./dist/map-engine/index.d.ts",
			"svelte": "./dist/map-engine/index.js",
			"default": "./dist/map-engine/index.js"
		},
		"./provider": {
			"types": "./dist/map-engine/provider.d.ts",
			"svelte": "./dist/map-engine/provider.js",
			"default": "./dist/map-engine/provider.js"
		},
		"./geocode": {
			"types": "./dist/map-engine/geocode.d.ts",
			"svelte": "./dist/map-engine/geocode.js",
			"default": "./dist/map-engine/geocode.js"
		},
		"./arcgis": {
			"types": "./dist/map-engine/arcgis/index.d.ts",
			"svelte": "./dist/map-engine/arcgis/index.js",
			"default": "./dist/map-engine/arcgis/index.js"
		},
		"./maplibre": {
			"types": "./dist/map-engine/maplibre/index.d.ts",
			"svelte": "./dist/map-engine/maplibre/index.js",
			"default": "./dist/map-engine/maplibre/index.js"
		},
		"./tiles": {
			"types": "./dist/map-engine/tiles/PmtilesLayerAdapter.d.ts",
			"svelte": "./dist/map-engine/tiles/PmtilesLayerAdapter.js",
			"default": "./dist/map-engine/tiles/PmtilesLayerAdapter.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"svelte": "./dist/testing/index.js",
			"default": "./dist/testing/index.js"
		}
	},
	"peerDependencies": {
		"@arcgis/core": "^5.0.0",
		"maplibre-gl": "^5.0.0",
		"svelte": "^5.0.0",
		"vitest": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"@arcgis/core": {
			"optional": true
		},
		"maplibre-gl": {
			"optional": true
		},
		"vitest": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"svelte",
		"map",
		"globe",
		"arcgis",
		"maplibre",
		"h3",
		"pmtiles"
	],
	"dependencies": {
		"@mapbox/vector-tile": "^2.0.4",
		"pbf": "^4.0.1",
		"pmtiles": "^4.4.0"
	},
	"devDependencies": {
		"@arcgis/core": "^5.1.12",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.50.1",
		"@sveltejs/package": "^2.5.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^22",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"jsdom": "^29.1.1",
		"maplibre-gl": "^5.24.0",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.3.14",
		"svelte": "^5.48.2",
		"svelte-check": "^4.3.5",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^7.3.1",
		"vitest": "^4.1.1"
	}
}
